# Copy into Vercel > Project > Settings > Environment Variables (Production + Preview)

# Supabase > Project Settings > API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Admin panel login password (/admin)
ADMIN_PASSWORD=choose-a-strong-password
# Optional: any long random string; if set, changing it signs out every admin device
ADMIN_SESSION_SECRET=

# Protects /api/cron/keepalive-cookies (any long random string)
CRON_SECRET=

# Gmail inbox that receives Netflix "Update household" emails
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-digit-app-password
